# ============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN TIỆM MÌ CAY (VERCEL / LOCAL)
# Dự án có thể chạy ngay mà KHÔNG CẦN file này.
# File này dùng khi bạn muốn tùy biến các tham số nâng cao.
# ============================================================

# Cổng chạy local (mặc định: 8000)
PORT=8000

# Mật khẩu bảo vệ trang Quản trị Admin (/admin.html)
# Để trống nếu không muốn đặt mật khẩu
ADMIN_PASSWORD=admin123

# Cấu hình tính năng bắt trộm & báo cảnh sát
# Tỷ lệ bắt trộm thành công (%): mặc định 50
POLICE_CATCH_RATE=50
# Chi phí báo cảnh sát (VNĐ): mặc định 100000
POLICE_FEE=100000

# Thời gian ca bán hàng mỗi ngày (giây): mặc định 210
DAY_DURATION_SEC=210

# Khóa bí mật nội bộ hệ thống (Checksum Salt)
SALT_PRE=mc!7Ay#q
SALT_POST=t0m~yum*
