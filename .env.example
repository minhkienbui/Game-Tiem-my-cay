# ============================================================
# CẤU HÌNH ĐỒNG BỘ BACKEND TOÀN BỘ NGƯỜI DÙNG & MÁY CHỦ (TIỆM MÌ CAY)
# ============================================================

# Cổng chạy local (mặc định: 8000)
PORT=8000

# ------------------------------------------------------------
# 1. ĐỒNG BỘ VỚI MÁY CHỦ TẬP TRUNG (KHUYÊN DÙNG CHO VERCEL)
# Khi bạn triển khai backend lên Render / Railway / VPS chạy 24/7,
# chỉ cần điền link backend đó vào đây trên Vercel Settings:
# ------------------------------------------------------------
REMOTE_BACKEND_URL=https://tiem-mi-cay-backend.onrender.com

# ------------------------------------------------------------
# 2. ĐỒNG BỘ VỚI TURSO CLOUD SQLITE (TÙY CHỌN DÀNH CHO VERCEL)
# Nếu bạn dùng dịch vụ SQLite đám mây miễn phí Turso (turso.tech):
# ------------------------------------------------------------
TURSO_DATABASE_URL=libsql://tiem-mi-cay-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ------------------------------------------------------------
# 3. THIẾT LẬP BẢO MẬT & QUẢN TRỊ
# ------------------------------------------------------------
# Mật khẩu bảo vệ trang Quản trị Admin (/admin)
ADMIN_PASSWORD=admin123

# Cấu hình tính năng bắt trộm & báo cảnh sát
POLICE_CATCH_RATE=50
POLICE_FEE=100000

# Thời gian ca bán hàng mỗi ngày (giây)
DAY_DURATION_SEC=210

# Khóa bí mật nội bộ hệ thống (Checksum Salt)
SALT_PRE=mc!7Ay#q
SALT_POST=t0m~yum*
